# Optional: push scraped data into Supabase instead of/in addition to
# writing data/*.json. Use the SECRET key from Project Settings -> API Keys
# (sb_secret_..., server-side only, never expose it to the browser / commit it).
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# How many characters to scrape per run. Defaults to 0 (all ~780, ~2-3 min).
# Set a small number (e.g. 25) for a quick partial run while testing.
SCRAPE_LIMIT=
