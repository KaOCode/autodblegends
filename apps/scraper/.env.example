# Optional: push scraped data into Supabase instead of/in addition to
# writing data/*.json. Use the service role key here (server-side only,
# never expose it to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# How many characters to scrape per run (0 = all ~780). Defaults to 40.
SCRAPE_LIMIT=40
