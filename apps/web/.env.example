# Optional: only needed if you want "sign in to keep your data across devices".
# Without these, the app runs entirely local-first (localStorage), no account needed.
# Use the "publishable" key from Supabase Project Settings -> API Keys
# (sb_publishable_..., safe for the browser). Never put the sb_secret_... key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
